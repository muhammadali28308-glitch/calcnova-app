
title = CalcNova
package.name = calcnova
package.domain = org.yourname

source.dir = .
source.include_exts = py,png,jpg,kv,atlas

version = 1.0
requirements = python3,kivy

orientation = portrait
fullscreen = 0

# (list) Permissions
android.permissions = 

# (int) Target Android API, minimum API etc. Buildozer defaults are usually fine.
android.minapi = 21

[buildozer]
log_level = 2
warn_on_root = 1
